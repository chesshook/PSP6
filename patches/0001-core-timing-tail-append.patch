 			prev->next = ptr->next;
 			FreeEvent(ptr);
 			ptr = prev->next;
@@ -411,6 +435,8 @@ void ProcessEvents() {
 			// INFO_LOG(Log::CPU, "%s (%lld, %lld) ", first->name ? first->name : "?", (u64)GetTicks(currentMIPS), (u64)first->time);
 			Event *evt = first;
 			first = first->next;
