@@ -53,4 +53,5 @@
 static int nextEventTypeRestoreId = -1;
 
 static Event *first;
+static Event *last;
 static Event *eventPool = 0;
 
@@ -217,9 +218,10 @@ void ClearPendingEvents()
 {
 	while (first)
 	{
 		Event *e = first->next;
 		FreeEvent(first);
 		first = e;
 	}
+	last = nullptr;
 }
 
@@ -228,17 +230,31 @@ void AddEventToQueue(Event* ne)
 {
+	// Scheduling at or after the tail is the common monotonic case. Keep the linked list
+	// (and its exact ordering semantics), but avoid rescanning it for those insertions.
+	if (!first) {
+		ne->next = nullptr;
+		first = last = ne;
+		return;
+	}
+	if (last && ne->time >= last->time) {
+		ne->next = nullptr;
+		last->next = ne;
+		last = ne;
+		return;
+	}
+
 	Event* prev = NULL;
 	Event** pNext = &first;
 	for(;;)
 	{
 		Event*& next = *pNext;
 		if(!next || ne->time < next->time)
 		{
 			ne->next = next;
 			next = ne;
+			if (!ne->next)
+				last = ne;
 			break;
 		}
 		prev = next;
 		pNext = &prev->next;
 	}
 }
 
@@ -283,6 +299,8 @@ s64 UnscheduleEvent(int event_type, u64 userdata)
 		}
 	}
